{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Identity": {
    "Password": {
      "RequiredLength": 8,
      "RequiredUniqueChars": 1,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": true
    },
    "PasswordExpirationDays": 182
  },
  "JwtSettings": {
  "Key": "replace-with-a-long-random-secret-256-bit",
  "Issuer": "KeepItSimple",
  "Audience": "KeepItSimple",
  "ExpiryMinutes": 60,
  "RefreshExpiryDays": 5
  },
  "AllowedHosts": "*"
}
