{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Identity": {
    "Password": {
      "RequiredLength": 8,
      "RequiredUniqueChars": 1,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": true,
      "ExpirationDays": 182
    }
  },
  "JwtSettings": {
  "Key": "replace-with-a-long-random-secret-256-bit",
  "Issuer": "KeepItSimple",
  "Audience": "KeepItSimple",
  "ExpiryMinutes": 60,
  "RefreshExpiryDays": 5
  },
  "Notifications": {
    "PollIntervalSeconds": 10,
    "BatchSize": 20,
    "MaxAttempts": 5,
    "RetryBaseSeconds": 30,
    "InAppRetentionDays": 30,
    "ReminderPollSeconds": 60
  },
  "Email": {
    "Host": "localhost",
    "Port": 1025,
    "UseSsl": false,
    "Username": "",
    "Password": "",
    "FromAddress": "no-reply@keepitsimple.local",
    "FromName": "KeepItSimple"
  },
  "Frontend": { 
    "BaseUrl":
    "http://localhost:3000"
  },
  "AllowedHosts": "*"
}
