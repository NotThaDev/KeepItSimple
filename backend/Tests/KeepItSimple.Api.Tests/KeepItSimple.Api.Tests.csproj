<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Fixture files are read from, and regenerated into, the shared tests/data folder. -->
    <TestDataRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', 'data'))</TestDataRoot>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="TestDataRoot" Value="$(TestDataRoot)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NPOI" Version="2.7.6" />
    <!-- NPOI 2.7.6 pulls in a vulnerable 8.0.2; override with a patched version. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../KeepItSimple.Api/KeepItSimple.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
